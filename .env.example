# Copy to .env, then fill these values locally. Never commit .env.
# Add your own key from Google AI Studio in your local .env file.
GEMINI_API_KEY=your_api_key_here
# Use an available model ID that supports structured JSON output.
GEMINI_MODEL=gemini-3.5-flash-lite

# Dedicated speech-to-text model; independent of the intake model.
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
