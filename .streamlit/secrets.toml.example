# Optional alternative to .env: copy to secrets.toml and fill locally.
# Never commit secrets.toml. Key and model values must be strings.
GEMINI_API_KEY = "your_api_key_here"
GEMINI_MODEL = "gemini-3.5-flash-lite"
# Dedicated speech-to-text model; independent of the intake model.
GEMINI_TRANSCRIPTION_MODEL = "gemini-3.5-transcribe"
